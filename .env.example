# Supabase: Project Settings > API
SUPABASE_URL=https://kpzazjwjqgclueqdqqtv.supabase.co
# Pakai service_role key (rahasia, hanya di server). Jangan beri awalan PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Acak panjang, minimal 16 karakter. Contoh buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Telegram: buat bot lewat @BotFather
TELEGRAM_BOT_TOKEN=
# Bebas, acak, huruf/angka/_/- saja (1-256 karakter). Dipakai Telegram untuk membuktikan permintaan asli.
TELEGRAM_WEBHOOK_SECRET=

# Asisten AI: penyedia mana pun yang kompatibel OpenAI (chat completions + tool calling)
AI_API_KEY=
# Opsional. Default SumoPod. Bisa juga diganti di menu Pengaturan.
AI_BASE_URL=https://ai.sumopod.com/v1
AI_MODEL=deepseek-v4-flash
